---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Points from '../components/Points.astro';
import Impact from '../components/Impact.astro';
import Studio from '../components/Studio.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';
import { useHome } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const home = useHome(lang);
---

<Layout title={home.meta.title}>
	<Navbar />
	<main class="grow">
		<Hero />
		<Points />
		<Impact />
		<Studio />
		<CTA />
	</main>
	<Footer />
</Layout>
