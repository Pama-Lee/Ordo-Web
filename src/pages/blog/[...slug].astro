---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'zh-CN');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postLang = post.data.lang || 'zh-CN';
const t = useTranslations(postLang as any);
const dateLocale = postLang === 'en' ? 'en-US' : postLang === 'zh-TW' ? 'zh-TW' : 'zh-CN';
const backText = postLang === 'en' ? 'Back to blog' : postLang === 'zh-TW' ? '返回部落格' : '返回博客';
---

<Layout title={post.data.title} description={post.data.description}>
  <Navbar />
  <main class="grow pt-24">

    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">

      <!-- Back link -->
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-[#9C9590] hover:text-[#2D2A26] transition-colors mb-8">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        {backText}
      </a>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          {post.data.tags.map((tag: string) => (
            <span class="text-[11px] font-mono font-semibold text-[#D4874D] bg-[#D4874D]/8 px-2.5 py-1 rounded-full">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="text-3xl md:text-4xl font-black text-[#2D2A26] tracking-[-0.03em] leading-tight mb-4">
          {post.data.title}
        </h1>
        <p class="text-[#6B6560] text-lg leading-relaxed mb-6">
          {post.data.description}
        </p>
        <div class="flex items-center gap-4 text-sm text-[#9C9590] border-t border-black/[0.06] pt-4">
          <span class="font-medium text-[#6B6560]">{post.data.author}</span>
          <span>·</span>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-warm">
        <Content />
      </div>

    </article>

  </main>
  <Footer />
</Layout>

<style is:global>
  .prose-warm {
    color: #2D2A26;
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .prose-warm h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #2D2A26;
    margin-top: 2.5em;
    margin-bottom: 0.8em;
    letter-spacing: -0.02em;
  }
  .prose-warm h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #2D2A26;
    margin-top: 2em;
    margin-bottom: 0.6em;
  }
  .prose-warm p {
    margin-bottom: 1.2em;
    color: #4a4540;
  }
  .prose-warm strong {
    color: #2D2A26;
    font-weight: 600;
  }
  .prose-warm a {
    color: #D4874D;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-warm a:hover {
    color: #B86E35;
  }
  .prose-warm ul, .prose-warm ol {
    padding-left: 1.5em;
    margin-bottom: 1.2em;
  }
  .prose-warm li {
    margin-bottom: 0.4em;
    color: #4a4540;
  }
  .prose-warm li::marker {
    color: #D4874D;
  }
  .prose-warm code {
    font-family: 'JetBrains Mono', monospace;
    background: rgba(0,0,0,0.05);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
    color: #B86E35;
  }
  .prose-warm pre {
    background: #2D2A26 !important;
    padding: 1.2em 1.5em !important;
    border-radius: 12px;
    overflow-x: auto;
    margin: 1.5em 0;
  }
  .prose-warm pre code {
    background: transparent;
    color: #e6e1da;
    padding: 0;
  }
  .prose-warm blockquote {
    border-left: 3px solid #D4874D;
    padding-left: 1em;
    margin: 1.5em 0;
    color: #6B6560;
    font-style: italic;
  }
  .prose-warm hr {
    border-color: rgba(0,0,0,0.08);
    margin: 2em 0;
  }
  .prose-warm img {
    width: 100%;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    margin: 1.5em 0;
    cursor: zoom-in;
    transition: opacity 0.15s;
  }
  .prose-warm img:hover { opacity: 0.88; }

  /* Lightbox */
  #lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: 24px;
    cursor: zoom-out;
    animation: lb-fade-in 0.18s ease;
  }
  #lightbox.open { display: flex; }
  #lightbox img {
    max-width: min(92vw, 1100px);
    max-height: 88vh;
    width: auto;
    border-radius: 10px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.5);
    cursor: default;
    margin: 0;
    border: none;
  }
  #lightbox-close {
    position: fixed;
    top: 16px;
    right: 20px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.18);
    color: white;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }
  #lightbox-close:hover { background: rgba(255,255,255,0.22); }
  @keyframes lb-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>

<div id="lightbox">
  <button id="lightbox-close" aria-label="Close">✕</button>
  <img id="lightbox-img" src="" alt="" />
</div>

<script is:inline>
  const lb     = document.getElementById('lightbox');
  const lbImg  = document.getElementById('lightbox-img');
  const lbClose = document.getElementById('lightbox-close');

  document.querySelectorAll('.prose-warm img').forEach(img => {
    img.addEventListener('click', () => {
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });

  function close() {
    lb.classList.remove('open');
    document.body.style.overflow = '';
  }

  lbClose.addEventListener('click', close);
  lb.addEventListener('click', e => { if (e.target === lb) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
</script>
