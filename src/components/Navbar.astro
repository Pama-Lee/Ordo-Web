---
import { getLangFromUrl, useTranslations, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const base = lang === 'zh-CN' ? '' : `/${lang}`;

let stars = 0;
try {
  const res = await fetch('https://api.github.com/repos/Ordo-Engine/Ordo', {
    headers: { Accept: 'application/vnd.github.v3+json' },
  });
  if (res.ok) stars = (await res.json()).stargazers_count ?? 0;
} catch {}
const starsLabel = stars >= 1000 ? `${(stars / 1000).toFixed(1)}k` : String(stars);
const starTooltip = lang === 'en'
  ? 'If Ordo has been useful to you, a star would mean a lot to us'
  : lang === 'zh-TW'
  ? '若 Ordo 对您有帮助，欢迎为我们点亮一颗 Star，感謝支持'
  : '若 Ordo 对你有帮助，欢迎为我们点亮一颗 Star，感谢支持';

const navItems = [
  { name: t('nav.features'),    href: `${base}/#features` },
  { name: t('nav.roadmap'),     href: `${base}/roadmap` },
  { name: t('nav.blog'),         href: `${base}/blog` },
  { name: t('nav.changelog'),    href: `${base}/changelog` },
  { name: t('nav.docs'),        href: 'https://docs.ordoengine.com' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-black/[0.08] bg-[#FAF8F5]/85 backdrop-blur-xl shadow-[0_1px_3px_rgba(0,0,0,0.04)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-[60px]">

      <!-- Logo -->
      <a href={lang === 'zh-CN' ? '/' : `/${lang}/`} class="flex items-center gap-2.5 group">
        <img src="/images/favicon_io/apple-touch-icon.png" alt="Ordo" class="h-7 w-7 rounded-lg transition-transform group-hover:scale-105" />
        <span class="text-[17px] font-semibold tracking-tight text-[#2D2A26]">Ordo</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class="px-3.5 py-2 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] rounded-lg hover:bg-black/[0.04] transition-all"
          >
            {item.name}
          </a>
        ))}

        <!-- Language switcher -->
        <div class="relative group/lang ml-1">
          <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] rounded-lg hover:bg-black/[0.04] transition-all">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            {languages[lang]}
            <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 top-full hidden group-hover/lang:block pt-1 z-50">
            <div class="bg-white border border-black/8 rounded-xl shadow-lg py-1.5 min-w-[130px]">
              {Object.entries(languages).map(([l, name]) => (
                <a
                  href={l === 'zh-CN' ? '/' : `/${l}/`}
                  class={`block px-4 py-2 text-xs font-medium transition-colors ${l === lang ? 'text-[#D4874D] bg-[#D4874D]/8' : 'text-[#6B6560] hover:text-[#2D2A26] hover:bg-black/[0.04]'}`}
                >
                  {name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Discord icon -->
        <a
          href="https://discord.gg/Y529FkArhh"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-[#6B6560] hover:text-[#5865F2] rounded-lg hover:bg-[#5865F2]/[0.06] transition-all"
          aria-label="Discord"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        </a>

        <!-- GitHub icon + star -->
        <a
          href="https://github.com/Ordo-Engine/Ordo"
          target="_blank"
          rel="noopener noreferrer"
          class="relative group/star flex items-center gap-1.5 px-2.5 py-2 text-[#6B6560] hover:text-[#2D2A26] rounded-lg hover:bg-black/[0.04] transition-all"
          aria-label="GitHub"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-[#D4874D]/10 text-[#B86E35] text-[10px] font-semibold font-mono">
            <svg class="h-2.5 w-2.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
            {starsLabel}
          </span>
          <span class="pointer-events-none absolute top-full right-0 mt-2 w-64 px-3 py-2 rounded-xl bg-[#2D2A26]/95 text-white text-[11px] leading-relaxed text-center opacity-0 group-hover/star:opacity-100 transition-opacity duration-200 z-50 shadow-xl border border-white/10 whitespace-normal">
            {starTooltip}
            <span class="absolute bottom-full right-6 border-[5px] border-transparent border-b-[#2D2A26]/95"></span>
          </span>
        </a>

        <!-- Primary CTA -->
        <a
          href="https://ordo-engine.github.io/Ordo/"
          target="_blank"
          class="relative group/playground ml-2 px-4 py-2 text-sm font-semibold text-white bg-[#2D2A26] hover:bg-[#1a1816] rounded-lg transition-all"
        >
          Try Studio
          <span class="pointer-events-none absolute top-full right-0 mt-2 w-64 px-3.5 py-2.5 rounded-xl bg-[#2D2A26]/95 backdrop-blur-sm text-white text-[11px] leading-relaxed font-normal text-center opacity-0 group-hover/playground:opacity-100 transition-opacity duration-200 z-50 shadow-xl whitespace-normal border border-white/10">
            {t('hero.playground_tooltip')}
            <span class="absolute bottom-full right-6 border-[5px] border-transparent border-b-[#2D2A26]/95"></span>
          </span>
        </a>
      </nav>

      <!-- Mobile controls -->
      <div class="md:hidden flex items-center gap-2">
        <div class="relative group/mobile-lang">
          <button class="p-2 text-[#6B6560] hover:text-[#2D2A26]">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
          </button>
          <div class="absolute right-0 top-full hidden group-hover/mobile-lang:block pt-1 z-50">
            <div class="bg-white border border-black/8 rounded-xl shadow-lg py-1.5 min-w-[120px]">
              {Object.entries(languages).map(([l, name]) => (
                <a
                  href={l === 'zh-CN' ? '/' : `/${l}/`}
                  class={`block px-4 py-2 text-xs font-medium transition-colors ${l === lang ? 'text-[#D4874D]' : 'text-[#6B6560] hover:text-[#2D2A26]'}`}
                >
                  {name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <button id="mobile-menu-button" class="p-2 text-[#6B6560] hover:text-[#2D2A26]">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-black/[0.08]">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {navItems.map(item => (
        <a href={item.href} class="block px-3 py-2.5 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] hover:bg-black/[0.04] rounded-lg transition-colors">
          {item.name}
        </a>
      ))}
      <a href="https://github.com/Ordo-Engine/Ordo" class="block px-3 py-2.5 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] hover:bg-black/[0.04] rounded-lg transition-colors">
        GitHub
      </a>
      <div class="pt-2">
        <a href="https://ordo-engine.github.io/Ordo/" target="_blank" class="relative group/playground block px-4 py-2.5 text-sm font-semibold text-white bg-[#2D2A26] hover:bg-[#1a1816] rounded-lg text-center transition-colors">
          Try Studio
          <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 px-3.5 py-2.5 rounded-xl bg-[#2D2A26]/95 backdrop-blur-sm text-white text-[11px] leading-relaxed font-normal text-center opacity-0 group-hover/playground:opacity-100 transition-opacity duration-200 z-50 shadow-xl whitespace-normal border border-white/10">
            {t('hero.playground_tooltip')}
            <span class="absolute top-full left-1/2 -translate-x-1/2 border-[5px] border-transparent border-t-[#2D2A26]/95"></span>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
