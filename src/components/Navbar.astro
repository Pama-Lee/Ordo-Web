---
import { getLangFromUrl, useTranslations, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const base = lang === 'zh-CN' ? '' : `/${lang}`;

const navItems = [
  { name: t('nav.features'),    href: `${base}/#features` },
  { name: t('nav.roadmap'),     href: `${base}/roadmap` },
  { name: t('nav.docs'),        href: 'https://docs.ordoengine.com' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-black/[0.08] bg-[#FAF8F5]/85 backdrop-blur-xl shadow-[0_1px_3px_rgba(0,0,0,0.04)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-[60px]">

      <!-- Logo -->
      <a href={lang === 'zh-CN' ? '/' : `/${lang}/`} class="flex items-center gap-2.5 group">
        <img src="/images/favicon_io/apple-touch-icon.png" alt="Ordo" class="h-7 w-7 rounded-lg transition-transform group-hover:scale-105" />
        <span class="text-[17px] font-semibold tracking-tight text-[#2D2A26]">Ordo</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class="px-3.5 py-2 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] rounded-lg hover:bg-black/[0.04] transition-all"
          >
            {item.name}
          </a>
        ))}

        <!-- GitHub -->
        <a
          href="https://github.com/Pama-Lee/Ordo"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-3.5 py-2 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] rounded-lg hover:bg-black/[0.04] transition-all"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          GitHub
        </a>

        <!-- Language switcher -->
        <div class="relative group/lang ml-1">
          <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] rounded-lg hover:bg-black/[0.04] transition-all">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            {languages[lang]}
            <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 top-full hidden group-hover/lang:block pt-1 z-50">
            <div class="bg-white border border-black/8 rounded-xl shadow-lg py-1.5 min-w-[130px]">
              {Object.entries(languages).map(([l, name]) => (
                <a
                  href={l === 'zh-CN' ? '/' : `/${l}/`}
                  class={`block px-4 py-2 text-xs font-medium transition-colors ${l === lang ? 'text-[#D4874D] bg-[#D4874D]/8' : 'text-[#6B6560] hover:text-[#2D2A26] hover:bg-black/[0.04]'}`}
                >
                  {name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Primary CTA -->
        <a
          href="https://pama-lee.github.io/Ordo/"
          target="_blank"
          class="ml-2 px-4 py-2 text-sm font-semibold text-white bg-[#2D2A26] hover:bg-[#1a1816] rounded-lg transition-all"
        >
          Try Studio
        </a>
      </nav>

      <!-- Mobile controls -->
      <div class="md:hidden flex items-center gap-2">
        <div class="relative group/mobile-lang">
          <button class="p-2 text-[#6B6560] hover:text-[#2D2A26]">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
          </button>
          <div class="absolute right-0 top-full hidden group-hover/mobile-lang:block pt-1 z-50">
            <div class="bg-white border border-black/8 rounded-xl shadow-lg py-1.5 min-w-[120px]">
              {Object.entries(languages).map(([l, name]) => (
                <a
                  href={l === 'zh-CN' ? '/' : `/${l}/`}
                  class={`block px-4 py-2 text-xs font-medium transition-colors ${l === lang ? 'text-[#D4874D]' : 'text-[#6B6560] hover:text-[#2D2A26]'}`}
                >
                  {name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <button id="mobile-menu-button" class="p-2 text-[#6B6560] hover:text-[#2D2A26]">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-black/[0.08]">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {navItems.map(item => (
        <a href={item.href} class="block px-3 py-2.5 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] hover:bg-black/[0.04] rounded-lg transition-colors">
          {item.name}
        </a>
      ))}
      <a href="https://github.com/Pama-Lee/Ordo" class="block px-3 py-2.5 text-sm font-medium text-[#6B6560] hover:text-[#2D2A26] hover:bg-black/[0.04] rounded-lg transition-colors">
        GitHub
      </a>
      <div class="pt-2">
        <a href="https://pama-lee.github.io/Ordo/" target="_blank" class="block px-4 py-2.5 text-sm font-semibold text-white bg-[#2D2A26] hover:bg-[#1a1816] rounded-lg text-center transition-colors">
          Try Studio
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
