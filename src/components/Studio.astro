---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, docsUrl } from '../i18n/home';
import TableStudio from './demo/TableStudio';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).studio;
// '|' marks where a CJK title may break, so phrases are not split mid-word.
const titleParts = c.title.split('|');
---

<section id="studio" class="py-24 reveal scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <p class="text-[13px] font-semibold text-[#B86E35] mb-4">{c.eyebrow}</p>
      <h2 class="font-black text-[#2D2A26] tracking-[-0.03em] leading-[1.15] mb-6"
        style="font-size: clamp(1.75rem, 3.5vw, 2.4rem);">{titleParts.length > 1 ? titleParts.map((t) => <span class="inline-block">{t}</span>) : c.title}</h2>
      <p class="text-[16px] text-[#6B6560] leading-relaxed mb-8">{c.desc}</p>
      <a href={docsUrl(lang, '/platform/studio')}
        class="inline-flex items-center gap-1.5 text-[15px] font-semibold text-[#2D2A26] hover:text-[#B86E35] transition-colors">
        {c.link}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <figure class="otable-frame">
      <figcaption class="sr-only">{c.shot_alt}</figcaption>
      <div class="otable-zoom">
        <TableStudio client:visible={{ rootMargin: '200px' }} lang={lang} />
      </div>
    </figure>
  </div>
</section>
