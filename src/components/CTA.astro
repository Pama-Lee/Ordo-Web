---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-28 relative overflow-hidden reveal">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Card -->
    <div class="relative rounded-[24px] p-[1px]"
      style="background: linear-gradient(135deg, rgba(212,135,77,0.3) 0%, rgba(124,107,90,0.15) 50%, rgba(90,143,123,0.2) 100%);">
      <div class="relative bg-white rounded-[23px] px-8 py-16 md:px-16 text-center overflow-hidden shadow-[0_12px_40px_rgba(0,0,0,0.04)]">

        <h2 class="relative z-10 font-black text-[#2D2A26] tracking-[-0.035em] leading-[1.05] mb-5"
          style="font-size: clamp(2rem, 5vw, 3.25rem);">
          {t('cta.title')}
        </h2>
        <p class="relative z-10 text-[#6B6560] text-lg mb-10 max-w-lg mx-auto leading-relaxed">
          {t('cta.desc')}
        </p>

        <div class="relative z-10 flex flex-col sm:flex-row justify-center gap-3">
          <a
            href="https://github.com/Pama-Lee/Ordo#quick-start"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 bg-[#2D2A26] hover:bg-[#1a1816] text-white font-semibold rounded-xl text-[15px] transition-all"
            style="animation: glow-pulse 3s ease-in-out infinite;"
          >
            {t('cta.btn_start')}
          </a>
          <a
            href="https://pama-lee.github.io/Ordo/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 bg-black/[0.04] hover:bg-black/[0.08] text-[#2D2A26] font-semibold rounded-xl border border-black/[0.08] text-[15px] transition-all"
          >
            {t('cta.btn_playground')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
