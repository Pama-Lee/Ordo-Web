---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-28 relative overflow-hidden reveal">
  <!-- Blue ambient glow -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-2/3 opacity-20"
      style="background: radial-gradient(ellipse, rgba(59,130,246,0.5) 0%, transparent 70%); filter: blur(80px);">
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Card with gradient border -->
    <div class="relative rounded-[24px] p-[1px]"
      style="background: linear-gradient(135deg, rgba(59,130,246,0.4), rgba(139,92,246,0.2), rgba(59,130,246,0.1))">
      <div class="relative bg-[#161b22] rounded-[23px] px-8 py-14 md:px-16 text-center overflow-hidden">
        <!-- Subtle grid -->
        <div class="absolute inset-0 bg-[url('/images/grid.svg')] opacity-[0.05] pointer-events-none"></div>
        <!-- Inner glow -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-32 opacity-30 pointer-events-none"
          style="background: radial-gradient(ellipse, rgba(59,130,246,0.4), transparent 70%); filter: blur(30px);">
        </div>

        <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-5 tracking-tight leading-tight relative z-10">
          {t('cta.title')}
        </h2>
        <p class="text-[#848d97] text-lg mb-10 max-w-xl mx-auto leading-relaxed relative z-10">
          {t('cta.desc')}
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-3 relative z-10">
          <a
            href="https://github.com/Pama-Lee/Ordo#quick-start"
            class="px-8 py-3.5 bg-[#3b82f6] hover:bg-[#2563eb] text-white font-semibold rounded-[10px] text-[15px] transition-all shadow-[0_0_24px_rgba(59,130,246,0.3)] hover:shadow-[0_0_32px_rgba(59,130,246,0.45)]"
          >
            {t('cta.btn_start')}
          </a>
          <a
            href="https://pama-lee.github.io/Ordo/"
            target="_blank"
            class="px-8 py-3.5 bg-white/[0.06] hover:bg-white/[0.10] text-white font-semibold rounded-[10px] border border-white/[0.10] text-[15px] transition-all"
          >
            {t('cta.btn_playground')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
