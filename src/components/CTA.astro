---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, docsUrl, PACKS_URL } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).cta;
---

<section class="py-24 border-t border-black/[0.06] reveal">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="[text-wrap:balance] font-black text-[#2D2A26] tracking-[-0.03em] leading-[1.15] mb-4"
      style="font-size: clamp(1.75rem, 3.5vw, 2.4rem);">{c.title}</h2>
    <p class="[text-wrap:balance] text-[16px] text-[#6B6560] leading-relaxed mb-9">{c.desc}</p>
    <div class="flex flex-col sm:flex-row justify-center gap-3">
      <a href={docsUrl(lang, '/guide/quick-start')}
        class="px-7 py-3 bg-[#2D2A26] hover:bg-[#1a1816] text-white font-semibold rounded-full text-[15px] transition-colors">{c.btn_primary}</a>
      <a href={PACKS_URL} target="_blank" rel="noopener noreferrer"
        class="px-7 py-3 text-[#2D2A26] hover:bg-black/[0.04] font-semibold rounded-full border border-black/[0.12] text-[15px] transition-colors">{c.btn_packs}</a>
    </div>
  </div>
</section>
