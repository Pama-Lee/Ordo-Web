---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="relative overflow-hidden">

  <!-- ── Ambient atmosphere ── -->
  <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
    <!-- Central blue glow -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[1000px] h-[700px]"
      style="background: radial-gradient(ellipse, rgba(59,130,246,0.20) 0%, transparent 65%); filter: blur(80px);">
    </div>
    <!-- Dot grid -->
    <div class="absolute inset-0"
      style="
        background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 100%);
      ">
    </div>
  </div>

  <!-- ── Text section ── -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center pt-28 pb-16">

    <!-- Badge -->
    <div class="hero-anim-1 inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[#3b82f6]/8 border border-[#3b82f6]/20 mb-8">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inset-0 rounded-full bg-[#3b82f6]" style="animation: dot-ping 1.6s ease-out infinite;"></span>
        <span class="relative h-1.5 w-1.5 rounded-full bg-[#3b82f6]"></span>
      </span>
      <span class="text-[11px] font-semibold text-[#3b82f6] tracking-[0.12em] uppercase font-mono">{t('hero.badge')}</span>
    </div>

    <!-- Headline -->
    <h1 class="hero-anim-2 font-black text-white leading-[0.92] tracking-[-0.04em] mb-5"
      style="font-size: clamp(2.8rem, 8vw, 5.5rem);">
      <span class="text-[#e6edf3]">{t('hero.title_part1')}</span><br />
      <span style="background: linear-gradient(110deg, #60a5fa 0%, #3b82f6 40%, #818cf8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        {t('hero.title_part2')}
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-anim-3 text-[#848d97] max-w-xl mx-auto mb-10 leading-relaxed"
      style="font-size: clamp(0.95rem, 2vw, 1.1rem);">
      {t('hero.subtitle')}
    </p>

    <!-- CTAs -->
    <div class="hero-anim-4 flex flex-col sm:flex-row items-center justify-center gap-3 mb-14">
      <a
        href="https://pama-lee.github.io/Ordo/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-3.5 bg-[#3b82f6] hover:bg-[#2563eb] text-white font-semibold rounded-[10px] text-[15px] transition-all flex items-center justify-center gap-2"
        style="animation: glow-pulse 3s ease-in-out infinite;"
      >
        {t('hero.cta_playground')}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href="https://github.com/Pama-Lee/Ordo"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-3.5 bg-white/[0.05] hover:bg-white/[0.09] border border-white/[0.10] text-[#e6edf3] font-semibold rounded-[10px] text-[15px] transition-all flex items-center justify-center gap-2"
      >
        {t('hero.cta_github')}
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </a>
    </div>

    <!-- 4-stat identity strip -->
    <div class="hero-anim-5 flex flex-wrap items-center justify-center gap-2">
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-lg bg-[#f97316]/8 border border-[#f97316]/15">
        <svg class="h-3.5 w-3.5 text-[#f97316]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class="text-[12px] font-semibold text-[#f97316]">{t('hero.stat_engine')}</span>
      </div>
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-lg bg-[#3b82f6]/8 border border-[#3b82f6]/15">
        <svg class="h-3.5 w-3.5 text-[#3b82f6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
        <span class="text-[12px] font-semibold text-[#3b82f6]">{t('hero.stat_platform')}</span>
      </div>
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-lg bg-[#8b5cf6]/8 border border-[#8b5cf6]/15">
        <svg class="h-3.5 w-3.5 text-[#8b5cf6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828" />
        </svg>
        <span class="text-[12px] font-semibold text-[#8b5cf6]">{t('hero.stat_studio')}</span>
      </div>
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white/[0.04] border border-white/[0.08]">
        <svg class="h-3.5 w-3.5 text-[#848d97]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span class="text-[12px] font-semibold text-[#848d97]">{t('hero.stat_license')}</span>
      </div>
    </div>
  </div>

  <!-- ── Product screenshot — the cinematic centerpiece ── -->
  <div class="hero-anim-6 relative px-3 sm:px-6 lg:px-10 max-w-[1440px] mx-auto">
    <div class="relative rounded-t-2xl overflow-hidden"
      style="
        border: 1px solid rgba(255,255,255,0.07);
        border-bottom: none;
        box-shadow:
          0 -24px 80px rgba(59,130,246,0.10),
          0 -8px 40px rgba(0,0,0,0.50),
          inset 0 1px 0 rgba(255,255,255,0.05);
      ">

      <!-- Browser chrome -->
      <div class="flex items-center gap-3 px-5 py-3 bg-[#161b22] border-b border-white/[0.06]">
        <div class="flex gap-1.5 shrink-0">
          <div class="w-3 h-3 rounded-full bg-[#ff5f56]/70"></div>
          <div class="w-3 h-3 rounded-full bg-[#ffbd2e]/70"></div>
          <div class="w-3 h-3 rounded-full bg-[#27c93f]/70"></div>
        </div>
        <div class="flex-1 flex justify-center">
          <div class="flex items-center gap-2 px-4 py-1.5 rounded-md bg-[#1c2128] border border-white/[0.05]">
            <svg class="h-3 w-3 text-[#545d68]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span class="text-[11px] text-[#545d68] font-mono">studio.ordoengine.com</span>
          </div>
        </div>
        <div class="shrink-0 flex gap-1">
          <div class="w-5 h-5 rounded bg-white/[0.03] border border-white/[0.05] flex items-center justify-center">
            <div class="w-2 h-px bg-[#545d68]"></div>
          </div>
          <div class="w-5 h-5 rounded bg-white/[0.03] border border-white/[0.05] flex items-center justify-center">
            <div class="w-2 h-2 rounded-sm border border-[#545d68]"></div>
          </div>
        </div>
      </div>

      <!-- Screenshot -->
      <img
        src="/images/main.png"
        alt="Ordo Studio — Visual Rule Editor"
        class="w-full block select-none"
        loading="eager"
        draggable="false"
      />
    </div>

    <!-- Bottom gradient fade -->
    <div class="absolute bottom-0 left-0 right-0 h-52 pointer-events-none"
      style="background: linear-gradient(to top, #0d1117 0%, rgba(13,17,23,0.6) 60%, transparent 100%);">
    </div>
  </div>

</div>
