---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, docsUrl, REPO_URL } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).hero;
const shotDir = lang === 'en' ? 'en' : 'zh';
const shots = ['flow', 'table', 'tests'].map((name, i) => ({
  src: `/images/screens/${shotDir}/${name}.webp`,
  label: c.shots[i].label,
  alt: c.shots[i].alt,
}));
const install = 'npm i -g @ordo-engine/cli';
---

<div class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-28 left-1/2 -translate-x-1/2 w-[900px] h-[500px]"
      style="background: radial-gradient(ellipse, rgba(212,135,77,0.08) 0%, rgba(245,241,234,0.04) 50%, transparent 76%); filter: blur(80px);">
    </div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center pt-32 pb-14">
    <div class="hero-anim-1 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#D4874D]/8 border border-[#D4874D]/15 mb-8">
      <span class="h-1.5 w-1.5 rounded-full bg-[#D4874D]"></span>
      <span class="text-[12px] font-semibold text-[#B86E35] tracking-[0.04em]">{c.badge}</span>
    </div>

    <h1 class="hero-anim-2 font-black text-[#2D2A26] leading-[1.02] tracking-[-0.04em] mb-6"
      style="font-size: clamp(2.6rem, 7.5vw, 5.25rem);">
      <span>{c.title1}</span><br />
      <span style="background: linear-gradient(115deg, #D4874D 0%, #B86E35 50%, #9C5A2A 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        {c.title2}
      </span>
    </h1>

    <p class="hero-anim-3 text-[#6B6560] max-w-2xl mx-auto mb-10 leading-relaxed"
      style="font-size: clamp(1rem, 2vw, 1.15rem);">
      {c.subtitle}
    </p>

    <div class="hero-anim-4 flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
      <a
        href={docsUrl(lang, '/guide/quick-start')}
        class="w-full sm:w-auto px-8 py-3.5 bg-[#2D2A26] hover:bg-[#1a1816] text-white font-semibold rounded-xl text-[15px] transition-all flex items-center justify-center gap-2"
        style="animation: glow-pulse 3s ease-in-out infinite;"
      >
        {c.cta_primary}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-3.5 bg-black/[0.04] hover:bg-black/[0.08] border border-black/[0.10] text-[#2D2A26] font-semibold rounded-xl text-[15px] transition-all flex items-center justify-center gap-2"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        {c.cta_github}
      </a>
    </div>

    <button
      type="button"
      class="hero-anim-5 copy-btn group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg font-mono text-[12.5px] text-[#6B6560] hover:text-[#2D2A26] transition-colors"
      data-code={install}
      data-copied-label="copied"
      aria-label={`Copy: ${install}`}
    >
      <span class="text-[#B8B0A8] select-none">$</span>
      <span>{install}</span>
      <svg class="h-3.5 w-3.5 opacity-50 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 012-2h10" /></svg>
    </button>
  </div>

  <!-- Studio screenshots, cycled. Labels double as manual tabs. -->
  <div class="hero-anim-6 relative px-3 sm:px-6 lg:px-10 max-w-[1320px] mx-auto" data-shots>
    <div class="flex items-center justify-center gap-1.5 mb-4" role="tablist">
      {shots.map((s, i) => (
        <button
          type="button"
          role="tab"
          data-shot-tab={i}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="shot-tab px-3.5 py-1.5 rounded-full text-[12.5px] font-semibold transition-colors"
        >{s.label}</button>
      ))}
    </div>
    <div class="relative rounded-2xl overflow-hidden"
      style="border: 1px solid rgba(0,0,0,0.10); box-shadow: 0 24px 80px rgba(0,0,0,0.08), 0 8px 32px rgba(0,0,0,0.04);">
      <div class="flex items-center gap-3 px-5 py-3 bg-[#f4efe6] border-b border-[#e6ddce]">
        <div class="flex gap-1.5 shrink-0">
          <div class="w-3 h-3 rounded-full bg-[#ff5f56]/70"></div>
          <div class="w-3 h-3 rounded-full bg-[#ffbd2e]/70"></div>
          <div class="w-3 h-3 rounded-full bg-[#27c93f]/70"></div>
        </div>
        <div class="flex-1 flex justify-center">
          <span class="px-4 py-1 rounded-md bg-white border border-[#e7ded0] text-[11px] text-[#8b7b67] font-mono">Ordo Studio</span>
        </div>
        <div class="w-12 shrink-0"></div>
      </div>
      <div class="relative aspect-[8/5] bg-[#f5f1e8]">
        {shots.map((s, i) => (
          <img
            src={s.src}
            alt={s.alt}
            data-shot={i}
            width="2400"
            height="1500"
            class={`shot absolute inset-0 h-full w-full object-cover object-top select-none transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
            loading={i === 0 ? 'eager' : 'lazy'}
            draggable="false"
          />
        ))}
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 pointer-events-none"
      style="background: linear-gradient(to top, #FAF8F5 0%, rgba(250,248,245,0.4) 52%, transparent 100%);">
    </div>
  </div>
</div>

<style>
  .shot-tab { color: #6B6560; background: rgba(0,0,0,0.03); }
  .shot-tab:hover { color: #2D2A26; }
  .shot-tab[aria-selected='true'] { color: #B86E35; background: rgba(212,135,77,0.10); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-shots]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[data-shot-tab]'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('[data-shot]'));
    let current = 0;
    let timer: number | undefined;
    const show = (i: number) => {
      current = i;
      shots.forEach((s, j) => {
        s.classList.toggle('opacity-100', j === i);
        s.classList.toggle('opacity-0', j !== i);
      });
      tabs.forEach((t, j) => t.setAttribute('aria-selected', j === i ? 'true' : 'false'));
    };
    const start = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => show((current + 1) % shots.length), 6000);
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => {
      window.clearInterval(timer);
      show(i);
    }));
    start();
  });
</script>
