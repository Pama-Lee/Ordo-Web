---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="relative overflow-hidden pt-24 pb-20 lg:pt-36 lg:pb-28">
  <!-- Background -->
  <div class="absolute inset-0 -z-10">
    <!-- Blue radial glow top center -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full opacity-30"
      style="background: radial-gradient(ellipse, rgba(59,130,246,0.45) 0%, rgba(59,130,246,0.08) 45%, transparent 70%); filter: blur(60px);">
    </div>
    <!-- Subtle grid -->
    <div class="absolute inset-0 bg-[url('/images/grid.svg')] bg-center opacity-[0.07]"
      style="mask-image: linear-gradient(180deg, rgba(255,255,255,0.6), rgba(255,255,255,0));">
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center gap-14 lg:gap-20 mb-16">

      <!-- Logo -->
      <div class="shrink-0 animate-fade-in hidden lg:block">
        <img src="/images/ordo-logo.png" alt="Ordo" class="h-48 w-48 lg:h-60 lg:w-60 drop-shadow-2xl" />
      </div>

      <!-- Copy -->
      <div class="text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#3b82f6]/10 border border-[#3b82f6]/20 mb-7 animate-fade-in">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#3b82f6] opacity-75"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#3b82f6]"></span>
          </span>
          <span class="text-[11px] font-semibold text-[#3b82f6] uppercase tracking-widest font-mono">{t('hero.badge')}</span>
        </div>

        <!-- Headline — Inter, not mono -->
        <h1 class="text-5xl md:text-7xl font-extrabold text-white mb-5 leading-[1.06] tracking-[-0.03em]">
          <span class="text-[#e6edf3]">{t('hero.title_part1')}</span><br />
          <span class="text-[#3b82f6]">{t('hero.title_part2')}</span>
        </h1>

        <p class="text-lg md:text-xl text-[#848d97] max-w-2xl mx-auto lg:mx-0 mb-10 leading-relaxed">
          {t('hero.subtitle')}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-3">
          <a
            href="https://pama-lee.github.io/Ordo/"
            target="_blank"
            class="px-7 py-3.5 bg-[#3b82f6] hover:bg-[#2563eb] text-white font-semibold rounded-[10px] transition-all text-[15px] shadow-[0_0_24px_rgba(59,130,246,0.3)] hover:shadow-[0_0_32px_rgba(59,130,246,0.45)] flex items-center justify-center gap-2"
          >
            {t('hero.cta_playground')}
            <svg class="h-4 w-4" fill="none" viewBox="0 0 20 20" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" />
            </svg>
          </a>
          <a
            href="https://github.com/Pama-Lee/Ordo"
            target="_blank"
            class="px-7 py-3.5 bg-white/[0.06] hover:bg-white/[0.10] text-[#e6edf3] font-semibold rounded-[10px] border border-white/[0.10] transition-all text-[15px] flex items-center justify-center gap-2"
          >
            {t('hero.cta_github')}
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Three-layer identity strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto pt-10 border-t border-white/[0.06]">
      <div class="flex flex-col items-center gap-1.5">
        <div class="h-8 w-8 rounded-lg bg-[#3b82f6]/10 border border-[#3b82f6]/20 flex items-center justify-center">
          <svg class="h-4 w-4 text-[#3b82f6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#e6edf3]">{t('hero.stat_engine')}</span>
        <span class="text-xs text-[#545d68] font-mono">fast & reliable</span>
      </div>

      <div class="flex flex-col items-center gap-1.5">
        <div class="h-8 w-8 rounded-lg bg-[#3b82f6]/10 border border-[#3b82f6]/20 flex items-center justify-center">
          <svg class="h-4 w-4 text-[#3b82f6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#e6edf3]">{t('hero.stat_platform')}</span>
        <span class="text-xs text-[#545d68] font-mono">org &amp; governance</span>
      </div>

      <div class="flex flex-col items-center gap-1.5">
        <div class="h-8 w-8 rounded-lg bg-[#8b5cf6]/10 border border-[#8b5cf6]/20 flex items-center justify-center">
          <svg class="h-4 w-4 text-[#8b5cf6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#e6edf3]">{t('hero.stat_studio')}</span>
        <span class="text-xs text-[#545d68] font-mono">visual authoring</span>
      </div>

      <div class="flex flex-col items-center gap-1.5">
        <div class="h-8 w-8 rounded-lg bg-white/[0.05] border border-white/[0.08] flex items-center justify-center">
          <svg class="h-4 w-4 text-[#848d97]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <span class="text-sm font-semibold text-[#e6edf3]">{t('hero.stat_license')}</span>
        <span class="text-xs text-[#545d68] font-mono">MIT licensed</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }
</style>
