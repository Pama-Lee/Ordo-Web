---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, docsUrl, REPO_URL } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).hero;
// '|' marks where a CJK subtitle may break, so phrases are not split mid-word.
const subtitleParts = c.subtitle.split('|');
const shot = `/images/screens/${lang === 'en' ? 'en' : 'zh'}/flow.webp`;
---

<section class="relative">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center pt-36 pb-16">
    <p class="hero-anim-1 text-[13px] font-semibold text-[#B86E35] tracking-[0.02em] mb-6">{c.eyebrow}</p>

    <h1 class="hero-anim-2 font-black text-[#2D2A26] leading-[1.05] tracking-[-0.04em] mb-6"
      style="font-size: clamp(2.5rem, 6.5vw, 4.5rem);">
      {c.title1}<br />
      <span class="text-[#C8743A]">{c.title2}</span>
    </h1>

    <p class="hero-anim-3 text-[#6B6560] max-w-xl mx-auto mb-10 leading-relaxed text-[17px]">
      {subtitleParts.length > 1 ? subtitleParts.map((t) => <span class="inline-block">{t}</span>) : c.subtitle}
    </p>

    <div class="hero-anim-4 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={docsUrl(lang, '/guide/quick-start')}
        class="w-full sm:w-auto px-7 py-3 bg-[#2D2A26] hover:bg-[#1a1816] text-white font-semibold rounded-full text-[15px] transition-colors text-center"
      >
        {c.cta_primary}
      </a>
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-7 py-3 text-[#2D2A26] hover:bg-black/[0.04] font-semibold rounded-full text-[15px] transition-colors flex items-center justify-center gap-2 border border-black/[0.12]"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        {c.cta_github}
      </a>
    </div>
  </div>

  <div class="hero-anim-5 max-w-[960px] mx-auto px-4 sm:px-6 pb-8">
    <img
      src={shot}
      alt={c.shot_alt}
      width="2400"
      height="1500"
      class="block w-full h-auto rounded-xl border border-black/[0.08] shadow-[0_20px_60px_rgba(45,42,38,0.08)] select-none"
      loading="eager"
      draggable="false"
    />
  </div>
</section>
