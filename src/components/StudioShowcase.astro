---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, docsUrl } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).studio;
const dir = lang === 'en' ? 'en' : 'zh';
const shots = ['flow', 'table', 'tests', 'facts'].map((n, i) => ({ src: `/images/screens/${dir}/${n}.webp`, label: c.tabs[i] }));
---

<section id="studio" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-studio>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-4">
        <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#9C9590] uppercase tracking-[0.12em] mb-3">
          <div class="h-px w-6 bg-black/15"></div>
          {c.eyebrow}
        </div>
        <h2 class="text-3xl md:text-[2.2rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-[1.15] mb-5">{c.title}</h2>
        <p class="text-[#6B6560] leading-relaxed mb-7 text-[15px]">{c.desc}</p>
        <ul class="space-y-3 mb-8">
          {c.bullets.map((b) => (
            <li class="flex items-start gap-3 text-[14px] text-[#6B6560]">
              <span class="mt-0.5 h-5 w-5 shrink-0 rounded-md bg-[#D4874D]/8 border border-[#D4874D]/15 flex items-center justify-center">
                <svg class="h-3 w-3 text-[#D4874D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              </span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <a href={docsUrl(lang, '/platform/studio')} class="inline-flex items-center gap-2 px-6 py-3 bg-[#2D2A26] hover:bg-[#1a1816] text-white font-semibold rounded-xl text-[14px] transition-all">
          {c.cta}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>

      <div class="lg:col-span-8 min-w-0">
        <div class="flex flex-wrap gap-1.5 mb-3" role="tablist">
          {shots.map((s, i) => (
            <button type="button" role="tab" data-studio-tab={i} aria-selected={i === 0 ? 'true' : 'false'}
              class="studio-tab px-3 py-1.5 rounded-lg text-[12.5px] font-semibold transition-colors">{s.label}</button>
          ))}
        </div>
        <div class="relative rounded-2xl overflow-hidden" style="border: 1px solid rgba(0,0,0,0.10); box-shadow: 0 24px 60px rgba(0,0,0,0.06);">
          <div class="relative aspect-[8/5] bg-[#f5f1e8]">
            {shots.map((s, i) => (
              <img src={s.src} alt={`Ordo Studio: ${s.label}`} data-studio-shot={i} width="2400" height="1500" loading="lazy" draggable="false"
                class={`absolute inset-0 h-full w-full object-cover object-top select-none ${i === 0 ? '' : 'hidden'}`} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .studio-tab { color: #6B6560; background: rgba(0,0,0,0.03); }
  .studio-tab:hover { color: #2D2A26; }
  .studio-tab[aria-selected='true'] { color: #fff; background: #2D2A26; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-studio]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[data-studio-tab]'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('[data-studio-shot]'));
    tabs.forEach((tab, i) => tab.addEventListener('click', () => {
      tabs.forEach((t, j) => t.setAttribute('aria-selected', j === i ? 'true' : 'false'));
      shots.forEach((s, j) => s.classList.toggle('hidden', j !== i));
    }));
  });
</script>
