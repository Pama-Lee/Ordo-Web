---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, PACKS_URL } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).packs;
const accents = ['#5A8F7B', '#D4874D', '#B4544F'];
---

<section id="packs" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#9C9590] uppercase tracking-[0.12em] mb-3">
          <div class="h-px w-6 bg-black/15"></div>
          {c.eyebrow}
        </div>
        <h2 class="text-3xl md:text-[2.5rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-tight mb-4">{c.title}</h2>
        <p class="text-[#6B6560] text-[15px] leading-relaxed">{c.desc}</p>
      </div>
      <a href={PACKS_URL} target="_blank" rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-black/[0.10] bg-white hover:bg-black/[0.03] text-[14px] font-semibold text-[#2D2A26] transition-colors">
        {c.link}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {c.items.map((p, i) => (
        <a href={`${PACKS_URL}/${p.key}`} target="_blank" rel="noopener noreferrer"
          class="group flex flex-col p-6 rounded-2xl bg-white border border-black/[0.07] hover:border-black/[0.14] hover:-translate-y-0.5 transition-all shadow-[0_2px_10px_rgba(0,0,0,0.03)]">
          <div class="flex items-center justify-between mb-4">
            <span class="font-mono text-[12px] font-semibold" style={`color: ${accents[i]};`}>{p.key}</span>
            <svg class="h-4 w-4 text-[#9C9590] group-hover:text-[#D4874D] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </div>
          <h3 class="text-[18px] font-bold text-[#2D2A26] tracking-tight mb-2">{p.name}</h3>
          <p class="text-[14px] text-[#6B6560] leading-relaxed mb-5 grow">{p.desc}</p>
          <div class="flex flex-wrap gap-1.5">
            {p.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded-md bg-[#F5F1EA] border border-black/[0.05] text-[11.5px] text-[#6B6560]">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <p class="mt-6 text-[13.5px] text-[#9C9590]">{c.note}</p>
  </div>
</section>
