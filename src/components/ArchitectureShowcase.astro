---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  'zh-CN': {
    eyebrow: 'Architecture',
    title: 'Ordo 整体架构',
    subtitle: 'Studio 是可视化工作台，Platform 是控制面，ordo-server 是执行引擎。三层通过 NATS JetStream 做规则同步，PostgreSQL 保存全部控制面状态。',
    diagramTitle: '系统层级概览',
    diagramSubtitle: '基于 compose.yml 的真实部署拓扑',
    componentsTitle: '组件详解',
    flowTitle: '请求执行路径',
    flowSubtitle: 'Studio → Platform → ordo-server 的完整请求链路',
    releaseTitle: '发布与审批路径',
    releaseSubtitle: '规则发布不是单次按钮，而是一个完整的治理流程',
