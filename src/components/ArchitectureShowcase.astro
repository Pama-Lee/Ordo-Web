      <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#9C9590] uppercase tracking-[0.12em] mb-3">
        <div class="h-px w-6 bg-black/15"></div>
        {copy.eyebrow}
      </div>
      <h1 class="text-3xl md:text-[2.75rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-tight mb-5">
        {copy.title}
      </h1>
      <p class="text-[#6B6560] text-base md:text-lg leading-relaxed">
        {copy.subtitle}
      </p>
    </div>

    <!-- ── System Layer Diagram ── -->
    <div class="mb-20">
      <div class="mb-6">
        <h2 class="text-xl font-bold text-[#2D2A26] tracking-tight mb-1">{copy.diagramTitle}</h2>
        <p class="text-[#9C9590] text-[13px] font-mono">{copy.diagramSubtitle}</p>
      </div>

      <div class="rounded-2xl bg-white border border-black/[0.08] overflow-hidden shadow-[0_4px_24px_rgba(0,0,0,0.04)] p-8">
        <!-- 3-layer visual diagram -->
        <div class="flex flex-col gap-3">

          <!-- Client layer: Studio -->
          <div class="grid grid-cols-1 lg:grid-cols-[100px_1fr] gap-3 items-center">
            <div class="hidden lg:flex items-center justify-end">
              <span class="text-[10px] font-mono font-semibold text-[#9C9590] uppercase tracking-widest">Client</span>
            </div>
            <div class="relative rounded-xl border-2 p-5" style="border-color: #D4874D20; background: linear-gradient(135deg, #fdf3ea, #fdf7f2);">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-lg flex items-center justify-center shrink-0 font-mono font-bold text-[11px]"
                    style="background: #D4874D15; border: 1px solid #D4874D30; color: #D4874D;">UI</div>
                  <div>
                    <div class="text-[13px] font-bold text-[#2D2A26] tracking-tight">Studio</div>
                    <div class="text-[11px] font-mono text-[#9C9590]">:3002 · Vue 3 · @xyflow</div>
                  </div>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {['Flow Editor', 'Decision Table', 'Trace', 'Templates'].map(t => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold" style="background: #D4874D12; color: #B86E35;">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Arrow down -->
          <div class="flex justify-center">
            <div class="flex flex-col items-center gap-0.5">
              <div class="h-6 w-px bg-black/15"></div>
              <span class="text-[10px] font-mono text-[#9C9590]">Vite /api proxy</span>
