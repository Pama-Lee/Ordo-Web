<!-- Mermaid CDN init -->
<script is:inline>
  (function () {
    function initMermaid() {
      import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(({ default: m }) => {
        m.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: {
            background: '#ffffff',
            primaryColor: '#fdf3ea',
            primaryTextColor: '#2D2A26',
            primaryBorderColor: '#e8ddd0',
            lineColor: '#D4874D',
            secondaryColor: '#f5f0eb',
            tertiaryColor: '#ecf5f1',
            tertiaryBorderColor: '#4A9E6B',
            fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif',
            fontSize: '13px',
            edgeLabelBackground: '#fff',
            clusterBkg: '#fdf7f0',
            clusterBorder: '#e8ddd0',
            actorBkg: '#fdf3ea',
            actorBorder: '#D4874D',
            actorTextColor: '#2D2A26',
            activationBkgColor: '#fdf3ea',
            activationBorderColor: '#D4874D',
            sequenceNumberColor: '#D4874D',
            noteBkgColor: '#fdf7f0',
            noteBorderColor: '#e8ddd0',
            noteTextColor: '#6B6560',
            labelBoxBkgColor: '#f5f0eb',
            labelBoxBorderColor: '#e0d8ce',
            labelTextColor: '#2D2A26',
            loopTextColor: '#6B6560',
            signalColor: '#D4874D',
            signalTextColor: '#2D2A26',
          },
        });
        m.run({ querySelector: '.ordo-mermaid' });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMermaid);
    } else {
      initMermaid();
    }
  })();
</script>

<div class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- ── Header ── -->
