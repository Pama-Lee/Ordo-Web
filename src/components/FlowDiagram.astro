---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-24 relative overflow-hidden reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="mb-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#9C9590] uppercase tracking-[0.12em] mb-3">
            <div class="h-px w-6 bg-black/15"></div>
            {t('flow.workspace_label')}
          </div>
          <h2 class="text-3xl md:text-[2.5rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-tight">
            {t('flow.workspace_title')}
          </h2>
        </div>
        <!-- Layer pills -->
        <div class="flex items-center gap-2 shrink-0">
          <span class="px-3 py-1.5 rounded-full text-xs font-semibold text-[#5A8F7B] bg-[#5A8F7B]/8 border border-[#5A8F7B]/18">{t('flow.layer_projects')}</span>
          <svg class="h-3 w-3 text-[#9C9590]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="px-3 py-1.5 rounded-full text-xs font-semibold text-[#7C6B5A] bg-[#7C6B5A]/8 border border-[#7C6B5A]/18">{t('flow.layer_rules')}</span>
          <svg class="h-3 w-3 text-[#9C9590]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="px-3 py-1.5 rounded-full text-xs font-semibold text-[#D4874D] bg-[#D4874D]/8 border border-[#D4874D]/18">{t('flow.layer_tests')}</span>
        </div>
      </div>
    </div>

    <!-- Large screenshot -->
    <div class="relative rounded-2xl overflow-hidden"
      style="
        border: 1px solid rgba(0,0,0,0.10);
        box-shadow: 0 24px 60px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.03);
      ">

      <!-- Window chrome -->
      <div class="flex items-center gap-3 px-5 py-3 bg-[#f4efe6] border-b border-[#e6ddce]">
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]/50"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]/50"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]/50"></div>
        </div>
        <div class="flex gap-2 ml-2 overflow-x-auto scrollbar-hide">
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-[#5A8F7B]/10 border border-[#5A8F7B]/20 shrink-0">
            <div class="w-1.5 h-1.5 rounded-full bg-[#5A8F7B]"></div>
            <span class="text-[10px] font-mono text-[#5A8F7B]">API Gateway Routing</span>
          </div>
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-white border border-[#e7ded0] shrink-0">
            <span class="text-[10px] font-mono text-[#8b7b67]">Rules</span>
          </div>
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-white border border-[#e7ded0] shrink-0">
            <span class="text-[10px] font-mono text-[#8b7b67]">Tests</span>
          </div>
        </div>
      </div>

      <!-- Screenshot -->
      <img
        src="/images/screenshots/image1.png"
        alt="Ordo Studio Flow Editor — API Gateway Routing"
        class="w-full block select-none"
        loading="lazy"
        draggable="false"
      />

      <!-- Bottom status bar -->
      <div class="flex items-center justify-between px-5 py-2.5 bg-[#f4efe6] border-t border-[#e6ddce]">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1.5 text-[10px] font-mono text-[#4A9E6B]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#4A9E6B]"></span>
            Ready
          </span>
          <span class="text-[10px] font-mono text-[#8b7b67]">7 steps · Rules + tests side by side</span>
        </div>
        <div class="flex items-center gap-3 text-[10px] font-mono text-[#8b7b67]">
          <span>Flow view</span>
          <span class="text-[#5A8F7B]">Project context</span>
          <span class="px-2 py-0.5 rounded bg-[#4A9E6B]/10 text-[#4A9E6B] font-semibold">5 TESTS PASSING</span>
        </div>
      </div>
    </div>

    <!-- 3 layer summaries -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
      <div class="flex items-start gap-3 px-5 py-4 rounded-xl bg-white border border-[#5A8F7B]/12">
        <div class="h-8 w-8 shrink-0 rounded-lg bg-[#5A8F7B]/8 border border-[#5A8F7B]/15 flex items-center justify-center">
          <svg class="h-4 w-4 text-[#5A8F7B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
        </div>
        <div>
          <div class="text-[10px] font-mono font-semibold text-[#5A8F7B] uppercase tracking-widest mb-0.5">{t('flow.layer_projects')}</div>
          <p class="text-xs text-[#6B6560] leading-relaxed">{t('flow.layer_projects_desc')}</p>
        </div>
      </div>
      <div class="flex items-start gap-3 px-5 py-4 rounded-xl bg-white border border-[#7C6B5A]/12">
        <div class="h-8 w-8 shrink-0 rounded-lg bg-[#7C6B5A]/8 border border-[#7C6B5A]/15 flex items-center justify-center">
          <svg class="h-4 w-4 text-[#7C6B5A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343" />
          </svg>
        </div>
        <div>
          <div class="text-[10px] font-mono font-semibold text-[#7C6B5A] uppercase tracking-widest mb-0.5">{t('flow.layer_rules')}</div>
          <p class="text-xs text-[#6B6560] leading-relaxed">{t('flow.layer_rules_desc')}</p>
        </div>
      </div>
      <div class="flex items-start gap-3 px-5 py-4 rounded-xl bg-white border border-[#D4874D]/12">
        <div class="h-8 w-8 shrink-0 rounded-lg bg-[#D4874D]/8 border border-[#D4874D]/15 flex items-center justify-center">
          <svg class="h-4 w-4 text-[#D4874D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <div class="text-[10px] font-mono font-semibold text-[#D4874D] uppercase tracking-widest mb-0.5">{t('flow.layer_tests')}</div>
          <p class="text-xs text-[#6B6560] leading-relaxed">{t('flow.layer_tests_desc')}</p>
        </div>
      </div>
    </div>

  </div>
</section>
