---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const roadmap = [
  {
    status: 'done',
    title: 'Phase 1: Foundation',
    version: 'v0.1 → v0.2',
    items: [
      'Core Rule Engine (Rust)',
      'HTTP & gRPC API Server',
      'Visual Rule Editor (Vue 3 + React)',
      'WASM Browser Execution',
      'Execution Tracing & Debugging',
      'JIT Compilation (Cranelift)',
      'Audit Logging & Version History',
      'Distributed Deployment (NATS JetStream)'
    ]
  },
  {
    status: 'done',
    title: 'Phase 2: Intelligence',
    version: 'v0.3 → v0.4',
    items: [
      'Data Filter API (SQL / JSON / MongoDB push-down)',
      'Partial Evaluation Engine',
      'Compiled Ruleset (.ordo binary format)',
      'Multi-tenant QPS Isolation',
      'Enterprise Plugin System'
    ]
  },
  {
    status: 'todo',
    title: 'Phase 3: Ecosystem',
    version: 'Next',
    items: [
      'Collaborative Editing',
      'Rule Marketplace',
      'Advanced Observability (full OTLP tracing)',
      'Kubernetes Native Operator'
    ]
  }
];
---

<section id="roadmap" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-black text-[#2D2A26] mb-4 tracking-tight">{t('roadmap.title')}</h2>
      <p class="text-[#6B6560] max-w-xl mx-auto">
        {t('roadmap.desc')}
      </p>
    </div>

    <!-- Vertical timeline -->
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-[19px] top-2 bottom-2 w-px bg-black/[0.08]"></div>

      <div class="space-y-12">
        {roadmap.map((phase, phaseIdx) => (
          <div class="relative pl-14">
            <!-- Timeline dot -->
            <div class={`absolute left-[12px] top-1.5 w-[15px] h-[15px] rounded-full border-[3px] ${
              phase.status === 'done'
                ? 'bg-[#4A9E6B] border-[#4A9E6B]/20'
                : phase.status === 'doing'
                  ? 'bg-[#D4874D] border-[#D4874D]/20'
                  : 'bg-[#9C9590] border-[#9C9590]/20'
            }`}></div>

            <!-- Phase header -->
            <div class="flex items-center gap-3 mb-4">
              <h3 class="text-lg font-bold text-[#2D2A26] tracking-tight">{phase.title}</h3>
              <span class={`text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${
                phase.status === 'done'
                  ? 'text-[#4A9E6B] bg-[#4A9E6B]/8'
                  : phase.status === 'doing'
                    ? 'text-[#D4874D] bg-[#D4874D]/8'
                    : 'text-[#9C9590] bg-black/[0.04]'
              }`}>
                {phase.version}
              </span>
              <span class={`text-[10px] font-semibold uppercase tracking-wider ${
                phase.status === 'done' ? 'text-[#4A9E6B]' : phase.status === 'doing' ? 'text-[#D4874D]' : 'text-[#9C9590]'
              }`}>
                {phase.status === 'done' ? t('roadmap.status_done') : phase.status === 'doing' ? t('roadmap.status_doing') : t('roadmap.status_todo')}
              </span>
            </div>

            <!-- Items -->
            <ul class="space-y-2.5">
              {phase.items.map(item => (
                <li class="flex items-start gap-2.5">
                  {phase.status === 'done' ? (
                    <svg class="h-4 w-4 text-[#4A9E6B] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  ) : (
                    <div class="h-4 w-4 shrink-0 mt-0.5 flex items-center justify-center">
                      <div class="w-1.5 h-1.5 rounded-full bg-[#9C9590]"></div>
                    </div>
                  )}
                  <span class={`text-sm leading-relaxed ${phase.status === 'done' ? 'text-[#6B6560]' : 'text-[#9C9590]'}`}>
                    {item}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
