---
import { getLangFromUrl } from '../i18n/utils';
import { useHome } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).problem;
const icons = [
  // scattered files
  '<path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />',
  // lock / stuck
  '<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />',
  // question
  '<path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
];
---

<section id="why" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#9C9590] uppercase tracking-[0.12em] mb-3">
        <div class="h-px w-6 bg-black/15"></div>
        {c.eyebrow}
      </div>
      <h2 class="text-3xl md:text-[2.5rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-tight">{c.title}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {c.items.map((item, i) => (
        <div class="p-6 rounded-2xl bg-white border border-black/[0.06] shadow-[0_2px_8px_rgba(0,0,0,0.03)]">
          <div class="h-9 w-9 rounded-lg flex items-center justify-center mb-4 bg-[#C75450]/[0.07] border border-[#C75450]/[0.15] text-[#B4544F]">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={icons[i]} />
          </div>
          <h3 class="text-[17px] font-bold text-[#2D2A26] mb-2 tracking-tight">{item.title}</h3>
          <p class="text-[#6B6560] text-[14px] leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 max-w-3xl text-[15px] leading-relaxed text-[#2D2A26] border-l-2 border-[#D4874D] pl-4">
      {c.ai_note}
    </p>
  </div>
</section>
