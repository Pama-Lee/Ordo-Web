---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  {
    title: t('quickstart.step1_title'),
    desc: t('quickstart.step1_desc'),
    code: `docker run -d -p 8080:8080 ghcr.io/pama-lee/ordo:latest`
  },
  {
    title: t('quickstart.step2_title'),
    desc: t('quickstart.step2_desc'),
    code: `curl http://localhost:8080/health`
  },
  {
    title: t('quickstart.step3_title'),
    desc: t('quickstart.step3_desc'),
    code: `curl -X POST http://localhost:8080/api/v1/execute/demo \\
  -H "Content-Type: application/json" \\
  -d '{"user": {"vip": true}}'`
  }
];
---

<section id="quickstart" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-[#2D2A26] mb-4 tracking-tight">{t('quickstart.title')}</h2>
      <p class="text-[#6B6560] max-w-2xl mx-auto">
        {t('quickstart.desc')}
      </p>
    </div>

    <div class="max-w-3xl mx-auto grid grid-cols-1 gap-6">
      {steps.map((step, index) => (
        <div class="flex flex-col gap-3 items-start">
          <div class="w-full">
            <div class="flex items-center gap-3 mb-2">
              <span class="flex items-center justify-center w-7 h-7 rounded-full bg-[#F5F1EA] border border-black/[0.08] text-[#D4874D] text-xs font-bold font-mono shrink-0">
                {index + 1}
              </span>
              <h3 class="text-base font-bold text-[#2D2A26] tracking-tight">{step.title}</h3>
            </div>
            <p class="text-[#6B6560] text-sm mb-3 ml-10">{step.desc}</p>
            <div class="ml-10 rounded-xl bg-[#F5F1EA] border border-black/[0.06] overflow-hidden group relative">
              <button class="absolute top-2.5 right-3 text-[10px] text-[#9C9590] hover:text-[#2D2A26] transition-colors uppercase font-mono tracking-wider copy-btn z-10" data-code={step.code}>
                Copy
              </button>
              <div class="text-[13px] overflow-x-auto px-4 py-3.5 font-mono text-[#6B6560] leading-relaxed whitespace-pre">{step.code}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const code = btn.getAttribute('data-code');
      if (code) {
        navigator.clipboard.writeText(code);
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = originalText;
        }, 2000);
      }
    });
  });
</script>
