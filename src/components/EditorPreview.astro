---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-24 relative overflow-hidden reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header + screenshot: split layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">

      <!-- Left: copy -->
      <div class="lg:col-span-4">
        <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#9C9590] uppercase tracking-[0.12em] mb-4">
          <div class="h-px w-6 bg-black/15"></div>
          Studio
        </div>

        <h2 class="text-3xl md:text-[2.2rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-[1.1] mb-5">
          {t('editor.title')}
        </h2>

        <p class="text-[#6B6560] leading-relaxed mb-8 text-[15px]">
          {t('editor.desc')}
        </p>

        <!-- Feature bullets -->
        <ul class="space-y-3 mb-10">
          <li class="flex items-center gap-3 text-sm text-[#6B6560]">
            <div class="h-5 w-5 shrink-0 rounded-md bg-[#D4874D]/8 border border-[#D4874D]/15 flex items-center justify-center">
              <svg class="h-3 w-3 text-[#D4874D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            {t('editor.view_multi')}
          </li>
          <li class="flex items-center gap-3 text-sm text-[#6B6560]">
            <div class="h-5 w-5 shrink-0 rounded-md bg-[#D4874D]/8 border border-[#D4874D]/15 flex items-center justify-center">
              <svg class="h-3 w-3 text-[#D4874D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            {t('editor.view_wasm')}
          </li>
          <li class="flex items-center gap-3 text-sm text-[#6B6560]">
            <div class="h-5 w-5 shrink-0 rounded-md bg-[#D4874D]/8 border border-[#D4874D]/15 flex items-center justify-center">
              <svg class="h-3 w-3 text-[#D4874D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            {t('editor.view_trace')}
          </li>
        </ul>

        <a
          href="https://ordo-engine.github.io/Ordo/"
          target="_blank"
          rel="noopener noreferrer"
          class="relative group/playground inline-flex items-center gap-2 px-6 py-3 bg-[#2D2A26] hover:bg-[#1a1816] text-white font-semibold rounded-xl text-[14px] transition-all"
        >
          {t('editor.cta_playground')}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-64 px-3.5 py-2.5 rounded-xl bg-[#2D2A26]/95 backdrop-blur-sm text-white text-[11px] leading-relaxed font-normal text-center opacity-0 group-hover/playground:opacity-100 transition-opacity duration-200 z-50 shadow-xl whitespace-normal border border-white/10">
            {t('hero.playground_tooltip')}
            <span class="absolute top-full left-1/2 -translate-x-1/2 border-[5px] border-transparent border-t-[#2D2A26]/95"></span>
          </span>
        </a>
      </div>

      <!-- Right: screenshot -->
      <div class="lg:col-span-8 relative group">
        <div class="relative rounded-2xl overflow-hidden"
          style="border: 1px solid rgba(0,0,0,0.10); box-shadow: 0 24px 60px rgba(0,0,0,0.06);">
          <!-- Chrome -->
          <div class="flex items-center gap-3 px-4 py-3 bg-[#f4efe6] border-b border-[#e6ddce]">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]/50"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]/50"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]/50"></div>
            </div>
            <div class="flex gap-1.5 ml-1 overflow-x-auto">
              <div class="px-3 py-0.5 rounded bg-[#D4874D]/8 border border-[#D4874D]/18 text-[10px] text-[#D4874D] font-mono shrink-0">
                built-in templates
              </div>
              <div class="px-3 py-0.5 rounded bg-white border border-[#e7ded0] text-[10px] text-[#8b7b67] font-mono shrink-0">
                GitHub marketplace
              </div>
            </div>
          </div>
          <!-- Screenshot -->
          <img
            src="/images/screenshots/template.png"
            alt="Ordo Studio — Template picker and project creation"
            class="w-full block transition-transform duration-700 group-hover:scale-[1.01]"
            loading="lazy"
            draggable="false"
          />
        </div>
      </div>
    </div>

  </div>
</section>
