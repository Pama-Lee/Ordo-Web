---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-24 relative overflow-hidden reveal">

  <!-- Background ambient -->
  <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[600px] h-[600px]"
      style="background: radial-gradient(ellipse, rgba(139,92,246,0.07) 0%, transparent 70%); filter: blur(80px);">
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header + screenshot: split layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">

      <!-- Left: copy -->
      <div class="lg:col-span-4">
        <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#7f91a8] uppercase tracking-[0.12em] mb-4">
          <div class="h-px w-6 bg-white/20"></div>
          Studio
        </div>

        <h2 class="text-3xl md:text-[2.2rem] font-black text-white tracking-[-0.03em] leading-[1.1] mb-5">
          {t('editor.title')}
        </h2>

        <p class="text-[#a8b5c7] leading-relaxed mb-8 text-[15px]">
          {t('editor.desc')}
        </p>

        <!-- Feature bullets -->
        <ul class="space-y-3 mb-10">
          <li class="flex items-center gap-3 text-sm text-[#a8b5c7]">
            <div class="h-5 w-5 shrink-0 rounded-md bg-[#8b5cf6]/10 border border-[#8b5cf6]/20 flex items-center justify-center">
              <svg class="h-3 w-3 text-[#8b5cf6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            {t('editor.view_multi')}
          </li>
          <li class="flex items-center gap-3 text-sm text-[#a8b5c7]">
            <div class="h-5 w-5 shrink-0 rounded-md bg-[#8b5cf6]/10 border border-[#8b5cf6]/20 flex items-center justify-center">
              <svg class="h-3 w-3 text-[#8b5cf6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            {t('editor.view_wasm')}
          </li>
          <li class="flex items-center gap-3 text-sm text-[#a8b5c7]">
            <div class="h-5 w-5 shrink-0 rounded-md bg-[#8b5cf6]/10 border border-[#8b5cf6]/20 flex items-center justify-center">
              <svg class="h-3 w-3 text-[#8b5cf6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            {t('editor.view_trace')}
          </li>
        </ul>

        <a
          href="https://pama-lee.github.io/Ordo/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-semibold rounded-[10px] text-[14px] transition-all"
          style="box-shadow: 0 0 20px rgba(139,92,246,0.25);"
        >
          {t('editor.cta_playground')}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Right: real screenshot, no fake sidebar -->
      <div class="lg:col-span-8 relative group">
        <!-- Glow behind screenshot -->
        <div class="absolute -inset-3 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
          style="background: radial-gradient(ellipse, rgba(139,92,246,0.15) 0%, transparent 70%); filter: blur(20px);">
        </div>

        <div class="relative rounded-2xl overflow-hidden"
          style="border: 1px solid rgba(255,255,255,0.16); box-shadow: 0 24px 80px rgba(8,12,20,0.34);">
          <!-- Chrome -->
          <div class="flex items-center gap-3 px-4 py-3 bg-[#f4efe6] border-b border-[#e6ddce]">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]/60"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]/60"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]/60"></div>
            </div>
            <div class="flex gap-1.5 ml-1 overflow-x-auto">
              <div class="px-3 py-0.5 rounded bg-[#8b5cf6]/10 border border-[#8b5cf6]/22 text-[10px] text-[#8b5cf6] font-mono shrink-0">
                built-in templates
              </div>
              <div class="px-3 py-0.5 rounded bg-white border border-[#e7ded0] text-[10px] text-[#8b7b67] font-mono shrink-0">
                GitHub marketplace
              </div>
            </div>
          </div>
          <!-- Flow screenshot -->
          <img
            src="/images/screenshots/template.png"
            alt="Ordo Studio — Template picker and project creation"
            class="w-full block transition-transform duration-700 group-hover:scale-[1.01]"
            loading="lazy"
            draggable="false"
          />
        </div>
      </div>
    </div>

  </div>
</section>
