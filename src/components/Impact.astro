---
import { getLangFromUrl } from '../i18n/utils';
import { useHome } from '../i18n/home';
import ImpactDemo from './demo/ImpactDemo';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).impact;
// '|' marks where a CJK title may break, so phrases are not split mid-word.
const titleParts = c.title.split('|');
const p = c.panel;
---

<section id="impact" class="py-24 bg-[#F5F1EA] reveal scroll-mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-16 items-center">
    <div>
      <p class="text-[13px] font-semibold text-[#B86E35] mb-4">{c.eyebrow}</p>
      <h2 class="font-black text-[#2D2A26] tracking-[-0.03em] leading-[1.15] mb-6"
        style="font-size: clamp(1.75rem, 3.5vw, 2.4rem);">{titleParts.length > 1 ? titleParts.map((t) => <span class="inline-block">{t}</span>) : c.title}</h2>
      <p class="text-[16px] text-[#6B6560] leading-relaxed mb-4">{c.p1}</p>
      <p class="text-[16px] text-[#6B6560] leading-relaxed mb-6">{c.p2}</p>
      <p class="text-[16px] text-[#2D2A26] font-medium leading-relaxed">{c.ai}</p>
    </div>

    <ImpactDemo client:visible={{ rootMargin: '200px' }} panel={p} />
  </div>
</section>
