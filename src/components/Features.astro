---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    key: 'editor',
    title: t('features.editor_title'),
    description: t('features.editor_desc'),
    color: '#8b5cf6',
    icon: `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`,
  },
  {
    key: 'performance',
    title: t('features.performance_title'),
    description: t('features.performance_desc'),
    color: '#f97316',
    icon: `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
  {
    key: 'wasm',
    title: t('features.wasm_title'),
    description: t('features.wasm_desc'),
    color: '#22c55e',
    icon: `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>`,
  },
  {
    key: 'audit',
    title: t('features.audit_title'),
    description: t('features.audit_desc'),
    color: '#3b82f6',
    icon: `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
  },
  {
    key: 'tenant',
    title: t('features.tenant_title'),
    description: t('features.tenant_desc'),
    color: '#3b82f6',
    icon: `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>`,
  },
  {
    key: 'filter',
    title: t('features.filter_title'),
    description: t('features.filter_desc'),
    color: '#22d3ee',
    icon: `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" /></svg>`,
  },
];

const useCases = [
  {
    title: t('features.usecase_finance'),
    description: t('features.usecase_finance_desc'),
    image: '/images/screenshots/image2.png',
    accent: '#3b82f6',
  },
  {
    title: t('features.usecase_ecommerce'),
    description: t('features.usecase_ecommerce_desc'),
    image: '/images/screenshots/template.png',
    accent: '#8b5cf6',
  },
  {
    title: t('features.usecase_routing'),
    description: t('features.usecase_routing_desc'),
    image: '/images/screenshots/servers.png',
    accent: '#f97316',
  },
];
---

<section id="features" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="mb-14">
      <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#7f91a8] uppercase tracking-[0.12em] mb-3">
        <div class="h-px w-6 bg-white/20"></div>
        {t('features.title')}
      </div>
      <h2 class="text-3xl md:text-[2.5rem] font-black text-white tracking-[-0.03em] leading-tight max-w-lg">
        {t('features.title')}
      </h2>
    </div>

    <!-- Use cases — large image-first cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-16">
      {useCases.map((uc) => (
        <div class="group relative overflow-hidden rounded-2xl border border-white/[0.12] hover:border-white/[0.22] transition-all duration-500 cursor-default bg-[#182335]/75 backdrop-blur-sm"
          style={`box-shadow: 0 14px 40px rgba(9,14,23,0.18), 0 0 0 0 ${uc.accent}00; transition: box-shadow 0.4s ease;`}>

          <!-- Screenshot - large, takes up most of card -->
          <div class="relative overflow-hidden" style="aspect-ratio: 16/10;">
            <img
              src={uc.image}
              alt={uc.title}
              class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.04]"
              style="opacity: 0.92;"
              loading="lazy"
            />
            <!-- Gradient from bottom -->
            <div class="absolute inset-0"
              style={`background: linear-gradient(to top, rgba(24,35,53,0.92) 0%, rgba(24,35,53,0.35) 36%, rgba(24,35,53,0.02) 72%);`}>
            </div>
            <!-- Color accent top bar -->
            <div class="absolute top-0 left-0 right-0 h-[2px]"
              style={`background: linear-gradient(90deg, transparent, ${uc.accent}, transparent); opacity: 0.6;`}>
            </div>
          </div>

          <!-- Caption -->
          <div class="px-6 py-5 bg-[#182335]">
            <h3 class="text-[15px] font-bold text-white mb-1.5 tracking-tight">{uc.title}</h3>
            <p class="text-[#a8b5c7] text-xs leading-relaxed">{uc.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Compact feature grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      {features.map(f => (
        <div
          class="group flex items-start gap-4 p-5 rounded-xl bg-[#1a2433]/95 border border-white/[0.10] hover:border-white/[0.18] hover:-translate-y-0.5 transition-all duration-200 shadow-[0_10px_28px_rgba(9,14,23,0.14)]"
        >
          <div
            class="h-9 w-9 shrink-0 rounded-lg flex items-center justify-center mt-0.5"
            style={`background: ${f.color}15; border: 1px solid ${f.color}25; color: ${f.color};`}
          >
            <Fragment set:html={f.icon} />
          </div>
          <div class="min-w-0">
            <h3 class="text-[14px] font-semibold text-white mb-1 tracking-tight">{f.title}</h3>
            <p class="text-[#a8b5c7] text-[12px] leading-relaxed">{f.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
