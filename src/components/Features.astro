---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    key: 'editor',
    title: t('features.editor_title'),
    description: t('features.editor_desc'),
    color: '#8b5cf6',
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`,
  },
  {
    key: 'performance',
    title: t('features.performance_title'),
    description: t('features.performance_desc'),
    color: '#f97316',
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
  {
    key: 'wasm',
    title: t('features.wasm_title'),
    description: t('features.wasm_desc'),
    color: '#22c55e',
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>`,
  },
  {
    key: 'audit',
    title: t('features.audit_title'),
    description: t('features.audit_desc'),
    color: '#3b82f6',
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
  },
  {
    key: 'tenant',
    title: t('features.tenant_title'),
    description: t('features.tenant_desc'),
    color: '#3b82f6',
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>`,
  },
  {
    key: 'filter',
    title: t('features.filter_title'),
    description: t('features.filter_desc'),
    color: '#22d3ee',
    icon: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" /></svg>`,
  },
];

const useCases = [
  {
    title: t('features.usecase_finance'),
    description: t('features.usecase_finance_desc'),
    image: '/images/main.png',
  },
  {
    title: t('features.usecase_ecommerce'),
    description: t('features.usecase_ecommerce_desc'),
    image: '/images/flow.png',
  },
  {
    title: t('features.usecase_routing'),
    description: t('features.usecase_routing_desc'),
    image: '/images/flow2.png',
  },
];
---

<section id="features" class="py-28 relative overflow-hidden reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">
        {t('features.title')}
      </h2>
      <p class="text-[#848d97] max-w-2xl mx-auto leading-relaxed">
        {t('features.description')}
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map(f => (
        <div
          class="group relative p-7 rounded-[16px] bg-[#161b22] border border-white/[0.06] hover:border-white/[0.12] transition-all duration-200 hover:-translate-y-1"
          style={`--feature-color: ${f.color}`}
        >
          <!-- Icon -->
          <div
            class="h-11 w-11 rounded-xl flex items-center justify-center mb-5 transition-colors duration-200"
            style={`background: ${f.color}1a; border: 1px solid ${f.color}30; color: ${f.color}`}
          >
            <Fragment set:html={f.icon} />
          </div>

          <!-- Title — Inter, not mono -->
          <h3 class="text-[16px] font-semibold text-white mb-2.5 tracking-tight">
            {f.title}
          </h3>
          <p class="text-[#848d97] text-sm leading-relaxed">
            {f.description}
          </p>

          <!-- Bottom accent on hover -->
          <div
            class="absolute bottom-0 left-6 right-6 h-[1px] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            style={`background: linear-gradient(90deg, transparent, ${f.color}40, transparent)`}
          ></div>
        </div>
      ))}
    </div>

    <!-- Use cases -->
    <div class="mt-28">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white tracking-tight">{t('features.usecase_title')}</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        {useCases.map(uc => (
          <div class="relative group overflow-hidden rounded-[16px] border border-white/[0.06] hover:border-white/[0.12] transition-all duration-300">
            <img
              src={uc.image}
              alt={uc.title}
              class="w-full h-56 object-cover transition-transform duration-500 group-hover:scale-105 opacity-50 group-hover:opacity-60"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0d1117] via-[#0d1117]/40 to-transparent p-7 flex flex-col justify-end">
              <h3 class="text-[17px] font-semibold text-white mb-1.5 tracking-tight">{uc.title}</h3>
              <p class="text-[#848d97] text-sm leading-relaxed">{uc.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
