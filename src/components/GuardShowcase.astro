---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cmd = 'npx @ordo-engine/cli guard init';
---

<section id="guard" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Heading -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D4874D]/[0.08] border border-[#D4874D]/[0.15] mb-5">
        <span class="text-[11px] font-semibold text-[#B86E35] tracking-[0.12em] uppercase font-mono">ordo guard</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-[#2D2A26] mb-4 tracking-tight">{t('guard.title')}</h2>
      <p class="text-[#6B6560] max-w-2xl mx-auto leading-relaxed">{t('guard.subtitle')}</p>
    </div>

    <!-- Demo GIF in a terminal-style frame -->
    <div class="relative rounded-2xl overflow-hidden mx-auto max-w-3xl"
      style="border: 1px solid rgba(0,0,0,0.10); box-shadow: 0 24px 80px rgba(0,0,0,0.08), 0 8px 32px rgba(0,0,0,0.04);">
      <div class="flex items-center gap-3 px-4 py-2.5 bg-[#f4efe6] border-b border-[#e6ddce]">
        <div class="flex gap-1.5 shrink-0">
          <div class="w-3 h-3 rounded-full bg-[#ff5f56]/70"></div>
          <div class="w-3 h-3 rounded-full bg-[#ffbd2e]/70"></div>
          <div class="w-3 h-3 rounded-full bg-[#27c93f]/70"></div>
        </div>
        <span class="text-[11px] text-[#8b7b67] font-mono">agent — ordo guard</span>
      </div>
      <img
        src="/images/guard-demo.gif"
        alt="ordo guard blocking a destructive agent command — deny, ask, allow — with a reason"
        class="block w-full select-none"
        loading="lazy"
        draggable="false"
        width="1280"
        height="720"
      />
    </div>

    <!-- One-command install -->
    <div class="max-w-xl mx-auto mt-8">
      <p class="text-center text-[13px] text-[#6B6560] mb-3">{t('guard.cmd_caption')}</p>
      <div class="rounded-xl bg-[#2D2A26] overflow-hidden group relative">
        <button class="absolute top-2.5 right-3 text-[10px] text-[#9C9590] hover:text-white transition-colors uppercase font-mono tracking-wider copy-btn z-10" data-code={cmd}>
          Copy
        </button>
        <div class="text-[13px] overflow-x-auto px-4 py-3.5 font-mono text-[#e8e2d8] leading-relaxed whitespace-pre">
          <span class="text-[#8b8178] select-none">$ </span>{cmd}
        </div>
      </div>
    </div>

  </div>
</section>
