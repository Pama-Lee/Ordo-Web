---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, docsUrl } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).guard;
const cmd = 'npx @ordo-engine/cli guard init';
---

<section id="guard" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-10 lg:gap-14 items-center">
      <div>
        <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#9C9590] uppercase tracking-[0.12em] mb-3">
          <div class="h-px w-6 bg-black/15"></div>
          {c.eyebrow}
        </div>
        <h2 class="text-3xl md:text-[2.2rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-[1.15] mb-5">{c.title}</h2>
        <p class="text-[#6B6560] leading-relaxed text-[15px] mb-7">{c.desc}</p>
        <p class="text-[13px] text-[#9C9590] mb-2">{c.cmd_caption}</p>
        <div class="rounded-xl bg-[#2D2A26] overflow-hidden relative">
          <button class="absolute top-2.5 right-3 text-[10px] text-[#9C9590] hover:text-white transition-colors uppercase font-mono tracking-wider copy-btn z-10" data-code={cmd}>Copy</button>
          <div class="text-[13px] overflow-x-auto px-4 py-3.5 font-mono text-[#e8e2d8] leading-relaxed whitespace-pre"><span class="text-[#8b8178] select-none">$ </span>{cmd}</div>
        </div>
        <a href={docsUrl(lang, '/platform/guard')} class="inline-flex items-center gap-1.5 mt-6 text-[14px] font-semibold text-[#B86E35] hover:text-[#9C5A2A]">
          {c.link}
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>

      <div class="relative rounded-2xl overflow-hidden min-w-0"
        style="border: 1px solid rgba(0,0,0,0.10); box-shadow: 0 24px 80px rgba(0,0,0,0.08), 0 8px 32px rgba(0,0,0,0.04);">
        <img
          src="/images/guard-demo.gif"
          alt="ordo guard denying a destructive agent command, asking before a push, and allowing a read-only one, each with a reason"
          class="block w-full select-none"
          loading="lazy"
          draggable="false"
          width="1280"
          height="720"
        />
      </div>
    </div>
  </div>
</section>
