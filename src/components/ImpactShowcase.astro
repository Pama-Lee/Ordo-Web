---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, docsUrl } from '../i18n/home';
import Terminal from './Terminal.astro';
import { thresholdDiff } from '../data/cli';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).impact;
---

<section id="impact" class="py-24 relative overflow-hidden reveal bg-[#F5F1EA] border-y border-black/[0.05]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-10 lg:gap-14 items-start">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D4874D]/[0.10] border border-[#D4874D]/[0.2] mb-5">
          <span class="text-[12px] font-semibold text-[#B86E35]">{c.eyebrow}</span>
        </div>
        <h2 class="text-3xl md:text-[2.4rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-[1.1] mb-6">{c.title}</h2>
        <div class="space-y-4 text-[15px] text-[#4A4540] leading-relaxed">
          <p>{c.p1}</p>
          <p>{c.p2}</p>
          <p>{c.p3}</p>
        </div>
        <ul class="mt-7 space-y-2.5">
          {c.points.map((pt) => (
            <li class="flex items-start gap-3 text-[14px] text-[#6B6560]">
              <span class="mt-[7px] h-1.5 w-1.5 rounded-full bg-[#D4874D] shrink-0"></span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
        <a href={docsUrl(lang, '/platform/cli')} class="inline-flex items-center gap-1.5 mt-7 text-[14px] font-semibold text-[#B86E35] hover:text-[#9C5A2A]">
          {c.link}
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
      <div class="min-w-0">
        <Terminal title="examples/rule-packs/fraud-scoring" lines={thresholdDiff} />
      </div>
    </div>
  </div>
</section>
