---
import { getLangFromUrl } from '../i18n/utils';
import { useHome, sitePrefix } from '../i18n/home';

const lang = getLangFromUrl(Astro.url);
const c = useHome(lang).ecosystem;
const base = sitePrefix(lang);
---

<section id="ecosystem" class="py-24 relative overflow-hidden reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-[#9C9590] uppercase tracking-[0.12em] mb-3">
        <div class="h-px w-6 bg-black/15"></div>
        {c.eyebrow}
      </div>
      <h2 class="text-3xl md:text-[2.5rem] font-black text-[#2D2A26] tracking-[-0.03em] leading-tight mb-4">{c.title}</h2>
      <p class="text-[#6B6560] text-[15px] leading-relaxed">{c.desc}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10">
      {c.stats.map((s) => (
        <div class="px-5 py-4 rounded-xl bg-[#F5F1EA] border border-black/[0.05]">
          <div class="font-mono font-bold text-[22px] text-[#2D2A26] tracking-tight">{s.value}</div>
          <div class="text-[12.5px] text-[#6B6560] mt-0.5">{s.label}</div>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      {c.items.map((item, i) => (
        <div class={`p-5 rounded-xl bg-white border shadow-[0_2px_8px_rgba(0,0,0,0.03)] ${i === 0 ? 'border-[#D4874D]/30' : 'border-black/[0.06]'}`}>
          <h3 class="text-[15px] font-bold text-[#2D2A26] mb-1.5 tracking-tight">{item.name}</h3>
          <p class="text-[13px] text-[#6B6560] leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    <a href={`${base}/benchmarks`} class="inline-flex items-center gap-1.5 mt-7 text-[14px] font-semibold text-[#B86E35] hover:text-[#9C5A2A]">
      {c.bench_link}
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
    </a>
  </div>
</section>
